# Daily database dump into var/backups/ (bin/estables backup); the number of
# dumps kept is backup.keep_daily. Started by estables-backup.timer; see
# estables-gc.service for installation.
#
# Photos are not dumped: copy public/media/originals/ and var/backups/ to
# another machine (docs/INSTALL.md, "Резервные копии").
#
# SPDX-License-Identifier: AGPL-3.0-or-later

[Unit]
Description=eStables: daily database backup
After=mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/php /var/www/estables/bin/estables backup
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
