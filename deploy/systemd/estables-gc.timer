# Starts estables-gc.service every night; see that file for installation.
#
# SPDX-License-Identifier: AGPL-3.0-or-later

[Unit]
Description=eStables: nightly clean-up

[Timer]
OnCalendar=*-*-* 04:17
RandomizedDelaySec=20m
# A night missed while the server was off is made up after boot.
Persistent=true

[Install]
WantedBy=timers.target
