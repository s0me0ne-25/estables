# Daily clean-up: unused photos, expired sessions, old login attempts and
# old journal entries (bin/estables gc). Started by estables-gc.timer.
#
# Install:
#   cp deploy/systemd/estables-* /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now estables-gc.timer estables-backup.timer
# Run now and see the result:
#   systemctl start estables-gc.service && journalctl -u estables-gc.service -n 5
#
# SPDX-License-Identifier: AGPL-3.0-or-later

[Unit]
Description=eStables: delete unused photos, expired sessions and old journal entries
After=mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/php /var/www/estables/bin/estables gc
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
